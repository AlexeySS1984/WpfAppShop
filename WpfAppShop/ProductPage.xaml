<Page x:Class="WpfAppShop.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppShop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Каталог" Loaded="Page_Loaded">

    <Grid Background="#F0F0F0">
        <ListView Name="LViewProducts" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Background="White" Margin="10" Width="200" Padding="10">
                        <StackPanel>
                            <Image Source="{Binding ImagePath}" Height="120" Stretch="Uniform"/>

                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="0,10,0,5" TextWrapping="Wrap" TextAlignment="Center"/>

                            <TextBlock Text="{Binding Price, StringFormat={}{0:N0} руб.}" FontSize="14" Foreground="Green" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                            <Button Content="В корзину" Click="BtnAdd_Click" Background="#007ACC" Foreground="White" Padding="5"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
