<Page x:Class="WpfAppShop.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppShop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Корзина" Loaded="Page_Loaded">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Ваша корзина" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <ListView Name="LViewCart" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding Title}" Width="300"/>
                    <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding Price, StringFormat={}{0:N2}}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <TextBlock Name="TxtTotal" Text="Итого: 0 руб." VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Margin="0,0,20,0"/>
            <Button Content="Очистить" Click="BtnClear_Click" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="Оформить заказ" Click="BtnCheckout_Click" Background="Green" Foreground="White" Padding="15,5"/>
        </StackPanel>
    </Grid>
</Page>
