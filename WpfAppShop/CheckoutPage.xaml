<Page x:Class="WpfAppShop.CheckoutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfAppShop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Оформление" Loaded="Page_Loaded">

    <Grid Margin="50">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Оформление заказа" FontSize="22" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="ФИО:"/>
            <TextBox Name="TxtFIO" Padding="5" Margin="0,5,0,15"/>

            <TextBlock Text="Email:"/>
            <TextBox Name="TxtEmail" Padding="5" Margin="0,5,0,15"/>

            <TextBlock Text="Адрес доставки:"/>
            <TextBox Name="TxtAddress" Padding="5" Margin="0,5,0,15"/>

            <TextBlock Name="TxtFinalPrice" Text="К оплате: 0 руб." FontSize="18" FontWeight="Bold" Foreground="DarkRed" Margin="0,10"/>

            <Button Content="ЗАКАЗАТЬ" Click="BtnOrder_Click" Height="40" Background="#FF4444" Foreground="White" FontWeight="Bold" Margin="0,20,0,0"/>
            <Button Content="Назад" Click="BtnBack_Click" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Ваши товары:" FontSize="16" Margin="0,0,0,10"/>
            <ListView Name="LViewOrderSummary" Height="300">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Товар" DisplayMemberBinding="{Binding Title}" Width="200"/>
                        <GridViewColumn Header="Цена" DisplayMemberBinding="{Binding Price}" Width="80"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
